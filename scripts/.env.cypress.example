# Copie ce fichier en .env.cypress puis complète les valeurs réelles.
# Il sera utilisé UNIQUEMENT pendant l'exécution des tests Cypress,
# à la place de ton .env habituel (voir scripts/run-cypress.js).

APP_NAME=Aramisc
APP_ENV=testing
APP_KEY=                      # copie la même valeur que dans ton .env actuel
APP_DEBUG=true
APP_URL=http://dev.aramisc.com

# Base de test copiée depuis la prod
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aramisc_test
DB_USERNAME=root
DB_PASSWORD=

# Garde les mêmes valeurs que ton .env pour le reste (mail, cache, session, etc.)
# sauf si tu veux aussi isoler ces services pendant les tests.
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
